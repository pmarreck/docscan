#!/usr/bin/env bash
# CLI black-box test suite for docscan.
# Run via: nix develop -c tests/cli/test-cli
#   or via the master test runner: ./test
set -u

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/../.." && pwd)"
BINARY="$ROOT_DIR/zig-out/bin/docscan"
TEST_DIR="$(mktemp -d "${TMPDIR:-/tmp}/docscan-cli-test-XXXXXX")"

# Source capture.bash — local copy for CI, fallback to dotfiles
if [ -f "$SCRIPT_DIR/../lib/capture.bash" ]; then
	source "$SCRIPT_DIR/../lib/capture.bash"
elif [ -f "$HOME/dotfiles/bin/src/capture.bash" ]; then
	source "$HOME/dotfiles/bin/src/capture.bash"
else
	echo "capture.bash not found" >&2; exit 1
fi

errors=0
tests=0
pass() { ((tests++)); printf '  \033[32mPASS\033[0m: %s\n' "$1"; }
fail() { ((tests++)); ((errors++)); printf '  \033[31mFAIL\033[0m: %s — %s\n' "$1" "$2"; }

# Ensure binary exists
if [ ! -f "$BINARY" ]; then
	echo "Binary not found at $BINARY — run './build' first" >&2
	exit 1
fi

trap 'rm -rf "$TEST_DIR"' EXIT

# ---------- Create test fixtures ----------

cat > "$TEST_DIR/contract.md" << 'FIXTURE'
# Service Agreement

This is a service agreement between parties.

## Indemnification

The service provider shall indemnify the client.

## Governing Law

This agreement is governed by New York law.
FIXTURE

mkdir -p "$TEST_DIR/subdir"
cat > "$TEST_DIR/subdir/notes.md" << 'FIXTURE'
# Meeting Notes

Discussed quarterly targets and budget allocation.
FIXTURE

mkdir -p "$TEST_DIR/path with spaces"
cat > "$TEST_DIR/path with spaces/spaced.md" << 'FIXTURE'
# Spaced Document

This document lives in a path with spaces.
FIXTURE

echo "binary junk" > "$TEST_DIR/file.xyz"

# Common DB path for tests that share state
DB="$TEST_DIR/test.db"

echo "=== docscan CLI Tests ==="

# ──────────────────────────────────────────────
# 1. --help exits 0 and shows USAGE
# ──────────────────────────────────────────────
local out err rc 2>/dev/null || true
out="" ; err="" ; rc=""
capture "$BINARY" --help
if [ "$rc" -eq 0 ] && echo "$out" | grep -q "USAGE"; then
	pass "--help exits 0 and shows USAGE"
else
	fail "--help exits 0 and shows USAGE" "rc=$rc, USAGE not found in stdout"
fi

# ──────────────────────────────────────────────
# 2. --about exits 0, shows "docscan" and version
# ──────────────────────────────────────────────
out="" ; err="" ; rc=""
capture "$BINARY" --about
if [ "$rc" -eq 0 ] && echo "$out" | grep -q "docscan" && echo "$out" | grep -qE '[0-9]+\.[0-9]+\.[0-9]+'; then
	pass "--about exits 0 and shows docscan + version"
else
	fail "--about exits 0 and shows docscan + version" "rc=$rc, out='$out'"
fi

# ──────────────────────────────────────────────
# 3. No args shows usage text
# ──────────────────────────────────────────────
out="" ; err="" ; rc=""
capture "$BINARY"
if echo "$out" | grep -qi "usage"; then
	pass "no args shows usage"
else
	fail "no args shows usage" "rc=$rc, 'usage' not found in stdout"
fi

# ──────────────────────────────────────────────
# 4. index with a single .md file succeeds
# ──────────────────────────────────────────────
out="" ; err="" ; rc=""
capture "$BINARY" index --db "$DB" "$TEST_DIR/contract.md"
if [ "$rc" -eq 0 ] && echo "$out" | grep -q "Indexing complete"; then
	pass "index single .md file succeeds"
else
	fail "index single .md file succeeds" "rc=$rc"
fi

# ──────────────────────────────────────────────
# 5. index with a directory succeeds
# ──────────────────────────────────────────────
out="" ; err="" ; rc=""
capture "$BINARY" index --db "$DB" "$TEST_DIR/subdir"
if [ "$rc" -eq 0 ] && echo "$out" | grep -q "Indexing complete"; then
	pass "index directory succeeds"
else
	fail "index directory succeeds" "rc=$rc"
fi

# ──────────────────────────────────────────────
# 6. index with no path exits non-zero
# ──────────────────────────────────────────────
out="" ; err="" ; rc=""
capture "$BINARY" index --db "$DB"
if [ "$rc" -ne 0 ] && echo "$err" | grep -qi "error"; then
	pass "index with no path exits non-zero"
else
	fail "index with no path exits non-zero" "rc=$rc"
fi

# ──────────────────────────────────────────────
# 7. status after index shows correct doc count
# ──────────────────────────────────────────────
out="" ; err="" ; rc=""
capture "$BINARY" status --db "$DB"
if [ "$rc" -eq 0 ] && echo "$out" | grep -q "Documents: 2"; then
	pass "status shows correct document count (2)"
else
	fail "status shows correct document count (2)" "rc=$rc, out='$out'"
fi

# ──────────────────────────────────────────────
# 8. status --json produces valid JSON
# ──────────────────────────────────────────────
out="" ; err="" ; rc=""
capture "$BINARY" status --json --db "$DB"
if [ "$rc" -eq 0 ] && echo "$out" | jq . > /dev/null 2>&1; then
	pass "status --json produces valid JSON"
else
	fail "status --json produces valid JSON" "rc=$rc, out='$out'"
fi

# ──────────────────────────────────────────────
# 9. search --exact finds indexed content
# ──────────────────────────────────────────────
out="" ; err="" ; rc=""
capture "$BINARY" search --exact --db "$DB" "indemnification"
if [ "$rc" -eq 0 ] && echo "$out" | grep -qi "indemnif"; then
	pass "search --exact finds indexed content"
else
	fail "search --exact finds indexed content" "rc=$rc, out='$out'"
fi

# ──────────────────────────────────────────────
# 10. search --exact for nonexistent term returns empty
# ──────────────────────────────────────────────
out="" ; err="" ; rc=""
capture "$BINARY" search --exact --db "$DB" "nonexistentxyzabc123"
if [ "$rc" -eq 0 ] && echo "$out" | grep -qi "no results"; then
	pass "search --exact for nonexistent term returns empty"
else
	fail "search --exact for nonexistent term returns empty" "rc=$rc, out='$out'"
fi

# ──────────────────────────────────────────────
# 11. search --json --exact produces valid JSON
# ──────────────────────────────────────────────
out="" ; err="" ; rc=""
capture "$BINARY" search --json --exact --db "$DB" "indemnification"
if [ "$rc" -eq 0 ] && echo "$out" | jq . > /dev/null 2>&1; then
	pass "search --json --exact produces valid JSON"
else
	fail "search --json --exact produces valid JSON" "rc=$rc, out='$out'"
fi

# ──────────────────────────────────────────────
# 12. search --limit 1 returns at most 1 result
# ──────────────────────────────────────────────
out="" ; err="" ; rc=""
capture "$BINARY" search --json --exact --limit 1 --db "$DB" "indemnification"
if [ "$rc" -eq 0 ]; then
	count=$(echo "$out" | jq 'length')
	if [ "$count" -le 1 ]; then
		pass "search --limit 1 returns at most 1 result (got $count)"
	else
		fail "search --limit 1 returns at most 1 result" "got $count results"
	fi
else
	fail "search --limit 1 returns at most 1 result" "rc=$rc"
fi

# ──────────────────────────────────────────────
# 13. config model returns a value
# ──────────────────────────────────────────────
out="" ; err="" ; rc=""
capture "$BINARY" config --db "$DB" model
if [ "$rc" -eq 0 ] && [ -n "$out" ]; then
	pass "config model returns a value ('$out')"
else
	fail "config model returns a value" "rc=$rc, out='$out'"
fi

# ──────────────────────────────────────────────
# 14. config set then get roundtrips
# ──────────────────────────────────────────────
out="" ; err="" ; rc=""
capture "$BINARY" config --db "$DB" test_key test_value_42
if [ "$rc" -eq 0 ]; then
	# Now retrieve it
	out="" ; err="" ; rc=""
	capture "$BINARY" config --db "$DB" test_key
	if [ "$rc" -eq 0 ] && [ "$out" = "test_value_42" ]; then
		pass "config set/get roundtrips"
	else
		fail "config set/get roundtrips" "expected 'test_value_42', got '$out'"
	fi
else
	fail "config set/get roundtrips" "set failed rc=$rc"
fi

# ──────────────────────────────────────────────
# 15. Paths with spaces work for index
# ──────────────────────────────────────────────
SPACED_DB="$TEST_DIR/spaced test.db"
out="" ; err="" ; rc=""
capture "$BINARY" index --db "$SPACED_DB" "$TEST_DIR/path with spaces"
if [ "$rc" -eq 0 ] && echo "$out" | grep -q "Indexing complete"; then
	pass "paths with spaces work for index"
else
	fail "paths with spaces work for index" "rc=$rc"
fi

# ──────────────────────────────────────────────
# 16. --no-color does not crash
# ──────────────────────────────────────────────
out="" ; err="" ; rc=""
capture "$BINARY" --no-color status --db "$DB"
if [ "$rc" -eq 0 ]; then
	pass "--no-color does not crash"
else
	fail "--no-color does not crash" "rc=$rc"
fi

# ──────────────────────────────────────────────
# 17. --simple does not crash
# ──────────────────────────────────────────────
out="" ; err="" ; rc=""
capture "$BINARY" --simple status --db "$DB"
if [ "$rc" -eq 0 ]; then
	pass "--simple does not crash"
else
	fail "--simple does not crash" "rc=$rc"
fi

# ──────────────────────────────────────────────
# 18. Unsupported file extension is handled gracefully
# ──────────────────────────────────────────────
out="" ; err="" ; rc=""
capture "$BINARY" index --db "$TEST_DIR/unsupported.db" "$TEST_DIR/file.xyz"
# Should not crash — may exit 0 with a warning or exit non-zero with a message
if [ "$rc" -le 1 ]; then
	# Check it gave some feedback about "unsupported" or "no supported"
	combined="$out$err"
	if echo "$combined" | grep -qi "unsupported\|no supported\|skip"; then
		pass "unsupported file extension handled gracefully"
	else
		pass "unsupported file extension did not crash (rc=$rc)"
	fi
else
	fail "unsupported file extension handled gracefully" "rc=$rc"
fi

# ──────────────────────────────────────────────
# 19. config.ini is created on index
# ──────────────────────────────────────────────
CFG_TEST_DIR="$(mktemp -d "${TMPDIR:-/tmp}/docscan-cfg-test-XXXXXX")"
echo "# Config test" > "$CFG_TEST_DIR/doc.md"
out="" ; err="" ; rc=""
capture "$BINARY" index "$CFG_TEST_DIR"
if [ "$rc" -eq 0 ] && [ -f "$CFG_TEST_DIR/.docscan/config.ini" ]; then
	pass "config.ini is created on index"
else
	fail "config.ini is created on index" "rc=$rc, file exists=$([ -f "$CFG_TEST_DIR/.docscan/config.ini" ] && echo yes || echo no)"
fi

# ──────────────────────────────────────────────
# 20. config.ini persists CLI flags (embedding-api)
# ──────────────────────────────────────────────
CFG_TEST_DIR2="$(mktemp -d "${TMPDIR:-/tmp}/docscan-cfg-test2-XXXXXX")"
echo "# Config persist test" > "$CFG_TEST_DIR2/doc.md"
out="" ; err="" ; rc=""
capture "$BINARY" index "$CFG_TEST_DIR2" --embedding-api openai --embedding-url http://localhost:8000 --model bge-m3-mlx
if [ "$rc" -eq 0 ]; then
	ini_content=""
	ini_content=$(cat "$CFG_TEST_DIR2/.docscan/config.ini" 2>/dev/null)
	if echo "$ini_content" | grep -q "api = openai" && \
	   echo "$ini_content" | grep -qE "url = http://(localhost|127\.0\.0\.1):8000" && \
	   echo "$ini_content" | grep -q "model = bge-m3-mlx"; then		pass "config.ini persists CLI flags (embedding-api, url, model)"
	else
		fail "config.ini persists CLI flags" "ini contents don't match expected values"
	fi
else
	fail "config.ini persists CLI flags" "index failed rc=$rc"
fi

# ──────────────────────────────────────────────
# 21. config dot-notation get reads from INI
# ──────────────────────────────────────────────
out="" ; err="" ; rc=""
capture "$BINARY" config --db "$CFG_TEST_DIR2/.docscan/index.db" embedding.api
if [ "$rc" -eq 0 ] && [ "$out" = "openai" ]; then
	pass "config dot-notation get (embedding.api = openai)"
else
	fail "config dot-notation get" "expected 'openai', got '$out' (rc=$rc)"
fi

# ──────────────────────────────────────────────
# 22. config dot-notation set modifies INI
# ──────────────────────────────────────────────
out="" ; err="" ; rc=""
capture "$BINARY" config --db "$CFG_TEST_DIR2/.docscan/index.db" embedding.url http://localhost:9999
if [ "$rc" -eq 0 ]; then
	out="" ; err="" ; rc=""
	capture "$BINARY" config --db "$CFG_TEST_DIR2/.docscan/index.db" embedding.url
	if [ "$rc" -eq 0 ] && [ "$out" = "http://localhost:9999" ]; then
		pass "config dot-notation set/get roundtrips"
	else
		fail "config dot-notation set/get roundtrips" "expected 'http://localhost:9999', got '$out'"
	fi
else
	fail "config dot-notation set/get roundtrips" "set failed rc=$rc"
fi

# ──────────────────────────────────────────────
# 23. config shows all values with INI sections
# ──────────────────────────────────────────────
out="" ; err="" ; rc=""
capture "$BINARY" config --db "$CFG_TEST_DIR2/.docscan/index.db"
if [ "$rc" -eq 0 ] && echo "$out" | grep -q "\[embedding\]" && echo "$out" | grep -q "\[search\]" && echo "$out" | grep -q "\[index\]"; then
	pass "config shows all values with INI sections"
else
	fail "config shows all values with INI sections" "rc=$rc, sections not found in output"
fi

# ──────────────────────────────────────────────
# 24. config --json shows all values as JSON
# ──────────────────────────────────────────────
out="" ; err="" ; rc=""
capture "$BINARY" config --json --db "$CFG_TEST_DIR2/.docscan/index.db"
if [ "$rc" -eq 0 ] && echo "$out" | jq . > /dev/null 2>&1; then
	api_val=$(echo "$out" | jq -r '."embedding.api"')
	if [ "$api_val" = "openai" ]; then
		pass "config --json shows all values as valid JSON"
	else
		fail "config --json shows all values as valid JSON" "embedding.api='$api_val'"
	fi
else
	fail "config --json shows all values as valid JSON" "rc=$rc, invalid JSON: '$out'"
fi

# ──────────────────────────────────────────────
# 25. legacy key 'model' still works (backward compat)
# ──────────────────────────────────────────────
out="" ; err="" ; rc=""
capture "$BINARY" config --db "$CFG_TEST_DIR2/.docscan/index.db" model
if [ "$rc" -eq 0 ] && [ "$out" = "bge-m3-mlx" ]; then
	pass "legacy key 'model' returns value from INI"
else
	fail "legacy key 'model' returns value from INI" "expected 'bge-m3-mlx', got '$out'"
fi

# Cleanup temp dirs
rm -rf "$CFG_TEST_DIR" "$CFG_TEST_DIR2"

# ──────────────────────────────────────────────
# 26. config debug shows sections and source annotations
# ──────────────────────────────────────────────
CFG_DEBUG_DIR="$(mktemp -d "${TMPDIR:-/tmp}/docscan-cfgdbg-XXXXXX")"
echo "# Debug test" > "$CFG_DEBUG_DIR/doc.md"
out="" ; err="" ; rc=""
capture "$BINARY" index "$CFG_DEBUG_DIR" --embedding-api openai --embedding-url http://localhost:8000 --model bge-m3-mlx
if [ "$rc" -eq 0 ]; then
	out="" ; err="" ; rc=""
	capture "$BINARY" config debug --db "$CFG_DEBUG_DIR/.docscan/index.db" --no-color
	if [ "$rc" -eq 0 ] && \
	   echo "$out" | grep -q "\[embedding\]" && \
	   echo "$out" | grep -q "\[search\]" && \
	   echo "$out" | grep -q "\[index\]" && \
	   echo "$out" | grep -q "(project:" && \
	   echo "$out" | grep -q "(default)"; then
		pass "config debug shows sections and source annotations"
	else
		fail "config debug shows sections and source annotations" "rc=$rc, out='$out'"
	fi
else
	fail "config debug shows sections and source annotations" "index failed rc=$rc"
fi

# ──────────────────────────────────────────────
# 27. config debug --json produces valid JSON with value+source keys
# ──────────────────────────────────────────────
out="" ; err="" ; rc=""
capture "$BINARY" config debug --json --db "$CFG_DEBUG_DIR/.docscan/index.db"
if [ "$rc" -eq 0 ] && echo "$out" | jq . > /dev/null 2>&1; then
	has_value=$(echo "$out" | jq 'to_entries[0].value | has("value")')
	has_source=$(echo "$out" | jq 'to_entries[0].value | has("source")')
	if [ "$has_value" = "true" ] && [ "$has_source" = "true" ]; then
		pass "config debug --json produces valid JSON with value+source"
	else
		fail "config debug --json produces valid JSON with value+source" "missing value/source keys"
	fi
else
	fail "config debug --json produces valid JSON with value+source" "rc=$rc, not valid JSON: '$out'"
fi

# ──────────────────────────────────────────────
# 28. config debug masks api_key
# ──────────────────────────────────────────────
# Set an api_key first
out="" ; err="" ; rc=""
capture "$BINARY" config --db "$CFG_DEBUG_DIR/.docscan/index.db" embedding.api_key "sk-test1234567890abcdef"
if [ "$rc" -eq 0 ]; then
	out="" ; err="" ; rc=""
	capture "$BINARY" config debug --db "$CFG_DEBUG_DIR/.docscan/index.db" --no-color
	if [ "$rc" -eq 0 ] && echo "$out" | grep -q "sk-test1\*\*\*"; then
		pass "config debug masks api_key (first 8 chars + ***)"
	else
		fail "config debug masks api_key" "rc=$rc, out='$out'"
	fi
else
	fail "config debug masks api_key" "config set failed rc=$rc"
fi

rm -rf "$CFG_DEBUG_DIR"

# ──────────────────────────────────────────────
# 29. extract plaintext from a markdown file
# ──────────────────────────────────────────────
cat > "$TEST_DIR/extract-test.md" << 'FIXTURE'
# Hello

World
FIXTURE
out="" ; err="" ; rc=""
capture "$BINARY" extract "$TEST_DIR/extract-test.md"
if [ "$rc" -eq 0 ] && echo "$out" | grep -q "World"; then
	pass "extract plaintext from markdown"
else
	fail "extract plaintext from markdown" "rc=$rc, out='$out', err='$err'"
fi

# ──────────────────────────────────────────────
# 30. extract plaintext includes heading text
# ──────────────────────────────────────────────
out="" ; err="" ; rc=""
capture "$BINARY" extract "$TEST_DIR/extract-test.md"
if [ "$rc" -eq 0 ] && echo "$out" | grep -q "Hello"; then
	pass "extract plaintext includes heading text"
else
	fail "extract plaintext includes heading text" "rc=$rc, out='$out'"
fi

# ──────────────────────────────────────────────
# 31. extract --markdown preserves headings
# ──────────────────────────────────────────────
out="" ; err="" ; rc=""
capture "$BINARY" extract --markdown "$TEST_DIR/extract-test.md"
if [ "$rc" -eq 0 ] && echo "$out" | grep -q "# Hello"; then
	pass "extract --markdown preserves headings"
else
	fail "extract --markdown preserves headings" "rc=$rc, out='$out', err='$err'"
fi

# ──────────────────────────────────────────────
# 32. extract --json has sections array
# ──────────────────────────────────────────────
out="" ; err="" ; rc=""
capture "$BINARY" extract --json "$TEST_DIR/extract-test.md"
if [ "$rc" -eq 0 ] && echo "$out" | jq -e '.sections' > /dev/null 2>&1; then
	pass "extract --json has sections array"
else
	fail "extract --json has sections array" "rc=$rc, out='$out', err='$err'"
fi

# ──────────────────────────────────────────────
# 33. extract --json has format field
# ──────────────────────────────────────────────
if echo "$out" | jq -e '.format' > /dev/null 2>&1; then
	pass "extract --json has format field"
else
	fail "extract --json has format field" "out='$out'"
fi

# ──────────────────────────────────────────────
# 34. extract --json has path field
# ──────────────────────────────────────────────
if echo "$out" | jq -e '.path' > /dev/null 2>&1; then
	pass "extract --json has path field"
else
	fail "extract --json has path field" "out='$out'"
fi

# ──────────────────────────────────────────────
# 35. extract from stdin via -
# ──────────────────────────────────────────────
out="" ; err="" ; rc=""
capture bash -c "echo '# Stdin Test
Content here' | \"$BINARY\" extract --format md -"
if [ "$rc" -eq 0 ] && echo "$out" | grep -q "Content here"; then
	pass "extract from stdin via -"
else
	fail "extract from stdin via -" "rc=$rc, out='$out', err='$err'"
fi

# ──────────────────────────────────────────────
# 36. extract with no file shows error
# ──────────────────────────────────────────────
out="" ; err="" ; rc=""
capture "$BINARY" extract
if [ "$rc" -ne 0 ]; then
	pass "extract with no file shows error"
else
	fail "extract with no file shows error" "rc=$rc (expected non-zero)"
fi

# ──────────────────────────────────────────────
# 37. extract unsupported format shows error
# ──────────────────────────────────────────────
echo "not a doc" > "$TEST_DIR/test.xyz"
out="" ; err="" ; rc=""
capture "$BINARY" extract "$TEST_DIR/test.xyz"
if [ "$rc" -ne 0 ]; then
	pass "extract unsupported format shows error"
else
	fail "extract unsupported format shows error" "rc=$rc (expected non-zero)"
fi

# ──────────────────────────────────────────────
# 38. extract from stdin via @stdin
# ──────────────────────────────────────────────
out="" ; err="" ; rc=""
capture bash -c "echo 'stdin alias test' | \"$BINARY\" extract --format txt @stdin"
if [ "$rc" -eq 0 ] && echo "$out" | grep -q "stdin alias test"; then
	pass "extract from stdin via @stdin"
else
	fail "extract from stdin via @stdin" "rc=$rc, out='$out', err='$err'"
fi

# ──────────────────────────────────────────────
# 39. extract with path containing spaces
# ──────────────────────────────────────────────
out="" ; err="" ; rc=""
capture "$BINARY" extract "$TEST_DIR/path with spaces/spaced.md"
if [ "$rc" -eq 0 ] && echo "$out" | grep -q "path with spaces"; then
	pass "extract with path containing spaces"
else
	fail "extract with path containing spaces" "rc=$rc, out='$out', err='$err'"
fi

# ──────────────────────────────────────────────
# 40. normalize subcommand fixes split words
# ──────────────────────────────────────────────
out="" ; err="" ; rc=""
capture bash -c "echo 'kn own' | \"$BINARY\" normalize"
if [ "$rc" -eq 0 ] && [ "$out" = "known" ]; then
	pass "normalize fixes 'kn own' -> 'known'"
else
	fail "normalize fixes 'kn own' -> 'known'" "rc=$rc, out='$out'"
fi

# ──────────────────────────────────────────────
# 41. normalize preserves valid word boundaries
# ──────────────────────────────────────────────
out="" ; err="" ; rc=""
capture bash -c "echo 'to me' | \"$BINARY\" normalize"
if [ "$rc" -eq 0 ] && [ "$out" = "to me" ]; then
	pass "normalize preserves 'to me'"
else
	fail "normalize preserves 'to me'" "rc=$rc, out='$out'"
fi

# ──────────────────────────────────────────────
# 42. normalize dehyphenates mis-managed
# ──────────────────────────────────────────────
out="" ; err="" ; rc=""
capture bash -c "echo 'mis-managed' | \"$BINARY\" normalize"
if [ "$rc" -eq 0 ] && [ "$out" = "mismanaged" ]; then
	pass "normalize dehyphenates 'mis-managed'"
else
	fail "normalize dehyphenates 'mis-managed'" "rc=$rc, out='$out'"
fi

# ──────────────────────────────────────────────
# 43. normalize keeps twenty-four hyphenated
# ──────────────────────────────────────────────
out="" ; err="" ; rc=""
capture bash -c "echo 'twenty-four' | \"$BINARY\" normalize"
if [ "$rc" -eq 0 ] && [ "$out" = "twenty-four" ]; then
	pass "normalize keeps 'twenty-four' hyphenated"
else
	fail "normalize keeps 'twenty-four' hyphenated" "rc=$rc, out='$out'"
fi

# ──────────────────────────────────────────────
# 44. normalize fixes nob ody with comma
# ──────────────────────────────────────────────
out="" ; err="" ; rc=""
capture bash -c "echo 'a nob ody, indeed' | \"$BINARY\" normalize"
if [ "$rc" -eq 0 ] && [ "$out" = "a nobody, indeed" ]; then
	pass "normalize fixes 'nob ody,' -> 'nobody,'"
else
	fail "normalize fixes 'nob ody,' -> 'nobody,'" "rc=$rc, out='$out'"
fi

# ──────────────────────────────────────────────
# 45. normalize fixes Greenbe rg (proper noun)
# ──────────────────────────────────────────────
out="" ; err="" ; rc=""
capture bash -c "echo 'Ace Greenbe rg' | \"$BINARY\" normalize"
if [ "$rc" -eq 0 ] && [ "$out" = "Ace Greenberg" ]; then
	pass "normalize fixes 'Greenbe rg' -> 'Greenberg'"
else
	fail "normalize fixes 'Greenbe rg' -> 'Greenberg'" "rc=$rc, out='$out'"
fi


# ──────────────────────────────────────────────
# 46. normalize handles hyphenated split with prefix
# ──────────────────────────────────────────────
out="" ; err="" ; rc=""
capture bash -c "echo 'it was mis-man aged poorly' | \"$BINARY\" normalize"
if [ "$rc" -eq 0 ] && [ "$out" = "it was mismanaged poorly" ]; then
	pass "normalize handles 'it was mis-man aged poorly' -> 'it was mismanaged poorly'"
