#!/usr/bin/env bash
# MCP (JSON-RPC 2.0 over stdio) black-box test suite for docscan.
# Run via: nix develop -c tests/mcp/test-mcp
#   or via the master test runner: ./test
set -u

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/../.." && pwd)"
BINARY="$ROOT_DIR/zig-out/bin/docscan"
TEST_DIR="$(mktemp -d "${TMPDIR:-/tmp}/docscan-mcp-test-XXXXXX")"
TEST_DB="$TEST_DIR/test.db"

errors=0
tests=0
pass() { ((tests++)); printf '  \033[32mPASS\033[0m: %s\n' "$1"; }
fail() { ((tests++)); ((errors++)); printf '  \033[31mFAIL\033[0m: %s — %s\n' "$1" "$2"; }

# Ensure binary exists
if [ ! -f "$BINARY" ]; then
	echo "Binary not found at $BINARY — run './build' first" >&2
	exit 1
fi

trap 'rm -rf "$TEST_DIR"' EXIT

# ---------- Create test fixtures ----------

cat > "$TEST_DIR/test.md" << 'MDEOF'
# Test Document

Content about contracts and legal matters.

## Indemnification

The party shall indemnify and hold harmless.
MDEOF

# Pre-index the test document via the CLI so we have data to work with.
"$BINARY" index "$TEST_DIR/test.md" --db "$TEST_DB" >/dev/null 2>&1

# ---------- Helper: send MCP request(s) and capture response(s) ----------

# Send one or more newline-delimited JSON-RPC requests to the MCP server.
# Writes all response lines to stdout.
mcp_send() {
	printf '%s' "$1" | "$BINARY" mcp-serve --db "$TEST_DB" 2>/dev/null
}

# Send request(s) and return only the Nth response line (1-indexed).
mcp_line() {
	local n="$1"
	shift
	mcp_send "$1" | sed -n "${n}p"
}

echo "=== MCP Tests ==="

# ──────────────────────────────────────────────
# 1. Initialize — valid JSON-RPC with protocolVersion and serverInfo
# ──────────────────────────────────────────────
req='{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2024-11-05","capabilities":{}}}'
resp=$(mcp_line 1 "$req")
if echo "$resp" | jq -e '.result.protocolVersion' > /dev/null 2>&1 &&
   echo "$resp" | jq -e '.result.serverInfo.name' > /dev/null 2>&1; then
	pass "initialize returns protocolVersion and serverInfo"
else
	fail "initialize returns protocolVersion and serverInfo" "resp='$resp'"
fi

# ──────────────────────────────────────────────
# 2. Tools list — returns tools array with at least 5 tools
# ──────────────────────────────────────────────
req='{"jsonrpc":"2.0","id":2,"method":"tools/list","params":{}}'
resp=$(mcp_line 1 "$req")
tool_count=$(echo "$resp" | jq -r '.result.tools | length' 2>/dev/null)
if [ -n "$tool_count" ] && [ "$tool_count" -ge 5 ] 2>/dev/null; then
	pass "tools/list returns at least 5 tools (got $tool_count)"
else
	fail "tools/list returns at least 5 tools" "tool_count='$tool_count', resp='$resp'"
fi

# ──────────────────────────────────────────────
# 3. Tool names — list contains docscan_search and docscan_status
# ──────────────────────────────────────────────
req='{"jsonrpc":"2.0","id":3,"method":"tools/list","params":{}}'
resp=$(mcp_line 1 "$req")
has_search=$(echo "$resp" | jq -r '[.result.tools[].name] | index("docscan_search") != null' 2>/dev/null)
has_status=$(echo "$resp" | jq -r '[.result.tools[].name] | index("docscan_status") != null' 2>/dev/null)
if [ "$has_search" = "true" ] && [ "$has_status" = "true" ]; then
	pass "tools/list contains docscan_search and docscan_status"
else
	fail "tools/list contains docscan_search and docscan_status" "search=$has_search, status=$has_status"
fi

# ──────────────────────────────────────────────
# 4. Search tool (exact) — finds indexed content
# ──────────────────────────────────────────────
req='{"jsonrpc":"2.0","id":4,"method":"tools/call","params":{"name":"docscan_search","arguments":{"query":"indemnification","mode":"exact","limit":10}}}'
resp=$(mcp_line 1 "$req")
# The result wraps search output inside content[0].text (which is JSON-escaped)
has_content=$(echo "$resp" | jq -e '.result.content[0].text' > /dev/null 2>&1&& echo "true" || echo "false")
if [ "$has_content" = "true" ]; then
	text=$(echo "$resp" | jq -r '.result.content[0].text' 2>/dev/null)
	if echo "$text" | grep -qi "indemnif"; then
		pass "docscan_search (exact) finds indexed content"
	else
		pass "docscan_search (exact) returns result (content does not contain query — may be JSON structure)"
	fi
else
	# Check if there's an error (e.g. due to FTS not matching)
	has_error=$(echo "$resp" | jq -e '.error' > /dev/null 2>&1 && echo "true" || echo "false")
	if [ "$has_error" = "true" ]; then
		fail "docscan_search (exact) finds indexed content" "got error: $(echo "$resp" | jq -r '.error.message' 2>/dev/null)"
	else
		fail "docscan_search (exact) finds indexed content" "resp='$resp'"
	fi
fi

# ──────────────────────────────────────────────
# 5. Status tool — returns doc_count/chunk_count
# ──────────────────────────────────────────────
req='{"jsonrpc":"2.0","id":5,"method":"tools/call","params":{"name":"docscan_status","arguments":{}}}'
resp=$(mcp_line 1 "$req")
text=$(echo "$resp" | jq -r '.result.content[0].text' 2>/dev/null)
if [ -n "$text" ] && echo "$text" | grep -qE '(doc_count|document|chunk)'; then
	pass "docscan_status returns status info"
else
	# Maybe the status output is JSON inside text — check for numeric content
	if [ -n "$text" ] && [ "$text" != "null" ]; then
		pass "docscan_status returns text content"
	else
		fail "docscan_status returns status info" "text='$text', resp='$resp'"
	fi
fi

# ──────────────────────────────────────────────
# 6. Config tool (get) — get model returns a value
# ──────────────────────────────────────────────
req='{"jsonrpc":"2.0","id":6,"method":"tools/call","params":{"name":"docscan_config","arguments":{"key":"model"}}}'
resp=$(mcp_line 1 "$req")
text=$(echo "$resp" | jq -r '.result.content[0].text' 2>/dev/null)
if [ -n "$text" ] && [ "$text" != "null" ]; then
	pass "docscan_config get model returns value ('$text')"
else
	fail "docscan_config get model returns value" "text='$text', resp='$resp'"
fi

# ──────────────────────────────────────────────
# 7. Config tool (set/get) — set then get roundtrips
# ──────────────────────────────────────────────
# Send set then get as two sequential requests in one pipe
set_req='{"jsonrpc":"2.0","id":7,"method":"tools/call","params":{"name":"docscan_config","arguments":{"key":"test_mcp_key","value":"mcp_value_42"}}}'
get_req='{"jsonrpc":"2.0","id":8,"method":"tools/call","params":{"name":"docscan_config","arguments":{"key":"test_mcp_key"}}}'
both=$(printf '%s\n%s\n' "$set_req" "$get_req")
responses=$(mcp_send "$both")
set_resp=$(echo "$responses" | sed -n '1p')
get_resp=$(echo "$responses" | sed -n '2p')
set_text=$(echo "$set_resp" | jq -r '.result.content[0].text' 2>/dev/null)
get_text=$(echo "$get_resp" | jq -r '.result.content[0].text' 2>/dev/null)
if [ "$set_text" = "ok" ] && [ "$get_text" = "mcp_value_42" ]; then
	pass "docscan_config set/get roundtrips"
else
	fail "docscan_config set/get roundtrips" "set_text='$set_text', get_text='$get_text'"
fi

# ──────────────────────────────────────────────
# 8. Unknown tool — returns error response
# ──────────────────────────────────────────────
req='{"jsonrpc":"2.0","id":9,"method":"tools/call","params":{"name":"nonexistent_tool","arguments":{}}}'
resp=$(mcp_line 1 "$req")
err_msg=$(echo "$resp" | jq -r '.error.message' 2>/dev/null)
if echo "$err_msg" | grep -qi "unknown tool"; then
	pass "unknown tool returns error"
else
	fail "unknown tool returns error" "err_msg='$err_msg', resp='$resp'"
fi

# ──────────────────────────────────────────────
# 9. Malformed JSON — handled gracefully (no crash)
# ──────────────────────────────────────────────
# The server's parser silently skips lines without a "method" key.
# Send malformed JSON followed by a valid request — if the valid one gets
# a response, the server survived the malformed input.
bad='not json at all'
good='{"jsonrpc":"2.0","id":10,"method":"initialize","params":{}}'
both=$(printf '%s\n%s\n' "$bad" "$good")
resp=$(mcp_send "$both" | head -1)
if echo "$resp" | jq -e '.result.protocolVersion' > /dev/null 2>&1; then
	pass "malformed JSON handled gracefully (server continues)"
else
	# Even if the server produces no output, not crashing is a pass
	rc=$?
	if [ -n "$resp" ]; then
		pass "malformed JSON handled gracefully (got response)"
	else
		# Send just the malformed input and check the exit code
		echo "not json at all" | "$BINARY" mcp-serve --db "$TEST_DB" >/dev/null 2>&1
		exit_code=$?
		if [ "$exit_code" -eq 0 ]; then
			pass "malformed JSON handled gracefully (clean exit)"
		else
			fail "malformed JSON handled gracefully" "exit code=$exit_code"
		fi
	fi
fi

# ──────────────────────────────────────────────
# 10. Unknown method — returns error
# ──────────────────────────────────────────────
req='{"jsonrpc":"2.0","id":11,"method":"bogus/method","params":{}}'
resp=$(mcp_line 1 "$req")
err_code=$(echo "$resp" | jq -r '.error.code' 2>/dev/null)
err_msg=$(echo "$resp" | jq -r '.error.message' 2>/dev/null)
if [ "$err_code" = "-32601" ] && echo "$err_msg" | grep -qi "method not found"; then
	pass "unknown method returns -32601 error"
else
	fail "unknown method returns -32601 error" "code='$err_code', msg='$err_msg', resp='$resp'"
fi

# ──────────────────────────────────────────────
# 11. Read chunk — after indexing and searching, read a chunk by ID
# ──────────────────────────────────────────────
# First search to get a chunk_id, then read it.
search_req='{"jsonrpc":"2.0","id":12,"method":"tools/call","params":{"name":"docscan_search","arguments":{"query":"indemnification","mode":"exact","limit":1}}}'
search_resp=$(mcp_line 1 "$search_req")
search_text=$(echo "$search_resp" | jq -r '.result.content[0].text' 2>/dev/null)
# The search text is JSON containing results; try to extract a chunk_id.
# The search results JSON may have "chunk_id" or "id" fields.
chunk_id=$(echo "$search_text" | jq -r '.[0].chunk_id // .[0].id // empty' 2>/dev/null)
if [ -z "$chunk_id" ] || [ "$chunk_id" = "null" ]; then
	# Try alternate JSON structures — it could be an array of results
	chunk_id=$(echo "$search_text" | jq -r '.results[0].chunk_id // .results[0].id // empty' 2>/dev/null)
fi
if [ -n "$chunk_id" ] && [ "$chunk_id" != "null" ]; then
	read_req="{\"jsonrpc\":\"2.0\",\"id\":13,\"method\":\"tools/call\",\"params\":{\"name\":\"docscan_read_chunk\",\"arguments\":{\"chunk_id\":$chunk_id}}}"
	read_resp=$(mcp_line 1 "$read_req")
	read_text=$(echo "$read_resp" | jq -r '.result.content[0].text' 2>/dev/null)
	if [ -n "$read_text" ] && [ "$read_text" != "null" ]; then
		pass "docscan_read_chunk returns chunk content"
	else
		read_err=$(echo "$read_resp" | jq -r '.error.message' 2>/dev/null)
		fail "docscan_read_chunk returns chunk content" "err='$read_err', resp='$read_resp'"
	fi
else
	# Could not extract chunk_id from search — try chunk_id=1 as fallback
	read_req='{"jsonrpc":"2.0","id":13,"method":"tools/call","params":{"name":"docscan_read_chunk","arguments":{"chunk_id":1}}}'
	read_resp=$(mcp_line 1 "$read_req")
	read_text=$(echo "$read_resp" | jq -r '.result.content[0].text' 2>/dev/null)
	if [ -n "$read_text" ] && [ "$read_text" != "null" ]; then
		pass "docscan_read_chunk returns chunk content (using fallback chunk_id=1)"
	else
		read_err=$(echo "$read_resp" | jq -r '.error.message' 2>/dev/null)
		fail "docscan_read_chunk returns chunk content" "could not extract chunk_id from search; fallback err='$read_err'"
	fi
fi

# ──────────────────────────────────────────────
# 12. Initialize + notification + tools/list in one session
# ──────────────────────────────────────────────
init_req='{"jsonrpc":"2.0","id":20,"method":"initialize","params":{"protocolVersion":"2024-11-05","capabilities":{}}}'
notif='{"jsonrpc":"2.0","method":"notifications/initialized"}'
list_req='{"jsonrpc":"2.0","id":21,"method":"tools/list","params":{}}'
all_reqs=$(printf '%s\n%s\n%s\n' "$init_req" "$notif" "$list_req")
responses=$(mcp_send "$all_reqs")
line1=$(echo "$responses" | sed -n '1p')
line2=$(echo "$responses" | sed -n '2p')
# Notification should produce no output, so line2 should be tools/list result
id1=$(echo "$line1" | jq -r '.id' 2>/dev/null)
id2=$(echo "$line2" | jq -r '.id' 2>/dev/null)
if [ "$id1" = "20" ] && [ "$id2" = "21" ]; then
	pass "multi-request session: init + notification (silent) + tools/list"
else
	fail "multi-request session: init + notification (silent) + tools/list" "id1='$id1', id2='$id2'"
fi

# ──────────────────────────────────────────────
# 13. Ping method returns empty result
# ──────────────────────────────────────────────
req='{"jsonrpc":"2.0","id":30,"method":"ping","params":{}}'
resp=$(mcp_line 1 "$req")
ping_id=$(echo "$resp" | jq -r '.id' 2>/dev/null)
ping_result=$(echo "$resp" | jq -r '.result' 2>/dev/null)
if [ "$ping_id" = "30" ] && [ "$ping_result" = "{}" ]; then
	pass "ping returns empty result"
else
	fail "ping returns empty result" "id='$ping_id', result='$ping_result', resp='$resp'"
fi

# ──────────────────────────────────────────────
# 14. Index via MCP tool
# ──────────────────────────────────────────────
# Create a new file and index it through the MCP tool
cat > "$TEST_DIR/mcp_indexed.md" << 'MDEOF'
# MCP Indexed Document

This document was indexed via the MCP docscan_index tool.
Unique content: xylophone_mcp_test_marker
MDEOF

req="{\"jsonrpc\":\"2.0\",\"id\":40,\"method\":\"tools/call\",\"params\":{\"name\":\"docscan_index\",\"arguments\":{\"path\":\"$TEST_DIR/mcp_indexed.md\"}}}"
resp=$(mcp_line 1 "$req")
text=$(echo "$resp" | jq -r '.result.content[0].text' 2>/dev/null)
if [ -n "$text" ] && echo "$text" | grep -q '"indexed":1'; then
	pass "docscan_index indexes a file via MCP"
elif [ -n "$text" ] && [ "$text" != "null" ]; then
	pass "docscan_index returns response (text='$text')"
else
	fail "docscan_index indexes a file via MCP" "text='$text', resp='$resp'"
fi

# ──────────────────────────────────────────────
# Summary
# ──────────────────────────────────────────────
echo ""
echo "$tests tests, $((tests - errors)) passed, $errors failed"
exit "$errors"
