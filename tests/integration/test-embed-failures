#!/usr/bin/env bash
# Integration tests for docscan's embedding-failure handling, driven by a
# scriptable mock embedding server (no Ollama / oMLX required).
#
# Proves end-to-end, against the real docscan binary, that:
#   A) a transient embedding failure is retried and the file still indexes
#   B) a persistent failure defers the file (not indexed, no zero vectors),
#      and a subsequent healthy run re-indexes it.
#
# Run via ./test or directly: nix develop -c tests/integration/test-embed-failures
set -u

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/../.." && pwd)"
BINARY="$ROOT_DIR/zig-out/bin/docscan"
CC="${CC:-cc}"

errors=0
tests=0
pass() { ((tests++)); printf '  \033[32mPASS\033[0m: %s\n' "$1"; }
fail() { ((tests++)); ((errors++)); printf '  \033[31mFAIL\033[0m: %s — %s\n' "$1" "$2"; }

echo "=== Embedding-failure integration tests ==="

if [ ! -x "$BINARY" ]; then
	echo "Binary not found at $BINARY — run ./build first" >&2
	exit 1
fi

WORK="$(mktemp -d "${TMPDIR:-/tmp}/docscan-embedfail-XXXXXX")"
MOCK_BIN="$WORK/mock-embed"
MOCK_PID=""
cleanup() {
	[ -n "$MOCK_PID" ] && kill "$MOCK_PID" 2>/dev/null
	rm -rf "$WORK"
}
trap cleanup EXIT

# Build the mock server (pure C, system compiler).
if ! "$CC" -std=c11 -O2 "$SCRIPT_DIR/mock-embed-server.c" -o "$MOCK_BIN"; then
	echo "failed to compile mock-embed-server" >&2
	exit 1
fi

# Start the mock with a given fail-plan; export DOCSCAN_* to target it.
# Args: <fail_csv>. Sets globals MOCK_PID and PORT.
start_mock() {
	local fail_csv="$1"
	local stall_csv="${2:-}"
	# Pick a port; retry a few times if taken.
	local attempt port
	for attempt in 1 2 3 4 5; do
		port=$(( 20000 + (RANDOM % 20000) ))
		"$MOCK_BIN" "$port" 8 "$fail_csv" "$stall_csv" > "$WORK/mock.out" 2>"$WORK/mock.err" &
		MOCK_PID=$!
		# Wait for readiness line (bounded by a poll, not a fixed sleep).
		local i
		for i in $(seq 1 100); do
			if grep -q "LISTENING $port" "$WORK/mock.out" 2>/dev/null; then
				PORT=$port
				return 0
			fi
			if ! kill -0 "$MOCK_PID" 2>/dev/null; then break; fi
			sleep 0.02
		done
		kill "$MOCK_PID" 2>/dev/null
		MOCK_PID=""
	done
	echo "could not start mock server" >&2
	return 1
}

stop_mock() {
	[ -n "$MOCK_PID" ] && kill "$MOCK_PID" 2>/dev/null
	wait "$MOCK_PID" 2>/dev/null
	MOCK_PID=""
}

# Run docscan index against the mock, returning the JSON summary on stdout.
run_index() {
	local dir="$1" db="$2"
	DOCSCAN_DB="$db" \
	DOCSCAN_EMBEDDING_API="openai" \
	DOCSCAN_EMBEDDING_URL="http://127.0.0.1:$PORT" \
	DOCSCAN_MODEL="mock" \
	DOCSCAN_EMBEDDING_API_KEY="test" \
		"$BINARY" index "$dir" --json --threads 2 --no-progress 2>"$WORK/idx.err"
}

# Extract an integer field from the JSON summary line.
json_field() { # <json> <key>
	printf '%s' "$1" | sed -n "s/.*\"$2\":\([0-9-]*\).*/\1/p"
}

# ---------- Test A: transient failure is retried ----------
# Request 1 = dimension probe (must succeed). Request 2 = the single batch's
# first attempt (fail 503). Request 3 = its retry (succeed).
mkdir -p "$WORK/corpusA"
cat > "$WORK/corpusA/doc.txt" <<'EOF'
The quick brown fox jumps over the lazy dog. This sentence exists so the
indexer produces at least one chunk to embed against the mock server.
EOF

if start_mock "2"; then
	out=$(run_index "$WORK/corpusA" "$WORK/dbA.db")
	idx=$(json_field "$out" indexed)
	dfr=$(json_field "$out" deferred)
	if [ "$idx" = "1" ] && [ "$dfr" = "0" ]; then
		pass "transient 503 retried; file indexed (indexed=1, deferred=0)"
	else
		fail "transient retry" "expected indexed=1 deferred=0, got '$out' (stderr: $(tr '\n' '|' <"$WORK/idx.err"))"
	fi
	stop_mock
else
	fail "transient retry" "mock failed to start"
fi

# ---------- Test B: persistent failure defers, then re-run indexes ----------
# Fail all 4 attempts of the batch (requests 2,3,4,5); probe (1) succeeds.
mkdir -p "$WORK/corpusB"
cat > "$WORK/corpusB/doc.txt" <<'EOF'
Persistent failure document. The embedding server will reject every attempt
to embed this file, so docscan must defer it for a later run.
EOF

if start_mock "2,3,4,5"; then
	out=$(run_index "$WORK/corpusB" "$WORK/dbB.db")
	idx=$(json_field "$out" indexed)
	dfr=$(json_field "$out" deferred)
	if [ "$idx" = "0" ] && [ "$dfr" = "1" ]; then
		pass "persistent failure defers file (indexed=0, deferred=1)"
	else
		fail "persistent defer" "expected indexed=0 deferred=1, got '$out' (stderr: $(tr '\n' '|' <"$WORK/idx.err"))"
	fi
	stop_mock

	# Re-run with a healthy server: the deferred file must now index.
	if start_mock ""; then
		out=$(run_index "$WORK/corpusB" "$WORK/dbB.db")
		idx=$(json_field "$out" indexed)
		dfr=$(json_field "$out" deferred)
		if [ "$idx" = "1" ] && [ "$dfr" = "0" ]; then
			pass "deferred file re-indexes on healthy re-run (indexed=1, deferred=0)"
		else
			fail "deferred re-run" "expected indexed=1 deferred=0, got '$out' (stderr: $(tr '\n' '|' <"$WORK/idx.err"))"
		fi
		stop_mock
	else
		fail "deferred re-run" "mock failed to start"
	fi
else
	fail "persistent defer" "mock failed to start"
fi

# ---------- Test C: batch (multi-threaded) path defer + re-index ----------
# 2 files -> 2 threads -> the Phase-2 batch path Peter actually ran. The single
# batch (chunks of both files) fails all attempts; both files must defer, then
# re-index on a healthy run.
mkdir -p "$WORK/corpusC"
cat > "$WORK/corpusC/one.txt" <<'EOF'
First document for the batch-path test. Contains enough words to chunk.
EOF
cat > "$WORK/corpusC/two.txt" <<'EOF'
Second document for the batch-path test. Also contains words to embed.
EOF

if start_mock "2,3,4,5"; then
	out=$(run_index "$WORK/corpusC" "$WORK/dbC.db")
	idx=$(json_field "$out" indexed)
	dfr=$(json_field "$out" deferred)
	if [ "$idx" = "0" ] && [ "$dfr" = "2" ]; then
		pass "batch-path persistent failure defers all files (indexed=0, deferred=2)"
	else
		fail "batch defer" "expected indexed=0 deferred=2, got '$out' (stderr: $(tr '\n' '|' <"$WORK/idx.err"))"
	fi
	stop_mock

	if start_mock ""; then
		out=$(run_index "$WORK/corpusC" "$WORK/dbC.db")
		idx=$(json_field "$out" indexed)
		dfr=$(json_field "$out" deferred)
		if [ "$idx" = "2" ] && [ "$dfr" = "0" ]; then
			pass "batch-path deferred files re-index on healthy run (indexed=2, deferred=0)"
		else
			fail "batch re-run" "expected indexed=2 deferred=0, got '$out' (stderr: $(tr '\n' '|' <"$WORK/idx.err"))"
		fi
		stop_mock
	else
		fail "batch re-run" "mock failed to start"
	fi
else
	fail "batch defer" "mock failed to start"
fi

# ---------- Test D: a stalled connection times out and defers (no hang) ----------
# The mock accepts the batch request then never responds (req 2..5); the probe
# (req 1) succeeds. With a short read timeout docscan must time out, retry, then
# defer — finishing quickly instead of blocking in read() forever. A timeout
# tool is a hard backstop: if the read-timeout regressed, docscan would hang and
# be killed with rc 124 -> test fails.
TIMEOUT_CMD=""
if command -v timeout >/dev/null 2>&1; then TIMEOUT_CMD="timeout"
elif command -v gtimeout >/dev/null 2>&1; then TIMEOUT_CMD="gtimeout"; fi

if [ -z "$TIMEOUT_CMD" ]; then
	printf '  \033[33mSKIP\033[0m: stall recovery (no timeout/gtimeout available)\n'
else
	mkdir -p "$WORK/corpusD"
	printf '# Stall Doc\n\nContent to embed against a stalling server.\n' > "$WORK/corpusD/doc.md"
	if start_mock "" "2,3,4,5"; then
		out=$(DOCSCAN_DB="$WORK/dbD.db" DOCSCAN_HTTP_READ_TIMEOUT_SECS=2 \
			DOCSCAN_EMBEDDING_API="openai" DOCSCAN_EMBEDDING_URL="http://127.0.0.1:$PORT" \
			DOCSCAN_MODEL="mock" DOCSCAN_EMBEDDING_API_KEY="test" \
			"$TIMEOUT_CMD" 30 "$BINARY" index "$WORK/corpusD" --json --threads 2 --no-progress 2>"$WORK/idx.err")
		rc=$?
		dfr=$(json_field "$out" deferred)
		if [ "$rc" != "124" ] && [ "$dfr" = "1" ]; then
			pass "stalled connection times out and defers (no hang)"
		else
			fail "stall recovery" "rc=$rc (124=hang), expected deferred=1, got '$out' (stderr: $(tr '\n' '|' <"$WORK/idx.err"))"
		fi
		stop_mock
	else
		fail "stall recovery" "mock failed to start"
	fi
fi

echo
printf '%d tests, %d passed, %d failed\n' "$tests" "$((tests - errors))" "$errors"
exit "$errors"


